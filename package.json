{
  "name": "brihadhee",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Brihadhee, a South Indian restaurant in Anna Nagar, Chennai.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npm run check",
    "build:site": "astro build",
    "preview": "astro preview",
    "check": "npm run check:facts && npm run check:seo && npm run check:compliance && npm run check:links",
    "check:compliance": "node scripts/verify-seo-compliance.ts",
    "check:facts": "node scripts/validate-seo-guardrails.js && node scripts/check-facts.mjs",
    "check:seo": "node scripts/validate-schema.js && node scripts/aeo-lint.mjs && node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs && node scripts/check-internal-links.mjs",
    "check:links:external": "node scripts/check-links.mjs dist --external",
    "indexnow": "node scripts/indexnow.mjs",
    "validate": "npm run check",
    "test": "node --test scripts/lead.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-seo-aeo-geo.mjs",
    "verify:lighthouse": "node scripts/verify-seo-aeo-geo.mjs --lighthouse"
  },
  "dependencies": {
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
