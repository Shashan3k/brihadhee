---
/**
 * /menu: a crawlable, JavaScript-free HTML menu generated from menu-canonical.ts.
 * Every price, count and range is computed from the data (src/lib/menu-facts.js).
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AtAGlance from "../components/AtAGlance.astro";
import BuildYourOwnDosa from "../components/BuildYourOwnDosa.astro";
import Faq from "../components/Faq.astro";
import { menuFaq } from "../data/faq.js";
import { getFact, openingTimes } from "../data/entity-truth.ts";
import { UNPRICED_SIGNATURES, BUILD_YOUR_OWN_DOSA } from "../data/menu-canonical.ts";
import { pageGraph, menuSchema, faqPageSchema, HOME_CRUMBS } from "../lib/schema.js";
import {
  categories,
  category,
  itemCount,
  allVegetarian,
  priceRange,
  rupees,
  currencySymbol,
  menuNotes,
} from "../lib/menu-facts.js";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const name = getFact("name");
const extras = UNPRICED_SIGNATURES;
const dosa = category("dosa");

const { range } = openingTimes();
const title = `${name} Menu | Dosa, Nellai Meals & Parotta, Anna Nagar`;
const description = `${name} menu with prices: build your own dosa, ${dosa.count} classic dosas, Nellai meals, parotta and filter coffee. Lunch and dinner, ${range} daily.`;
const schema = pageGraph({
  path: "/menu/",
  title,
  description,
  crumbs: [...HOME_CRUMBS, { name: "Menu", path: "/menu/" }],
  extras: [menuSchema({ categories, extras, byo: BUILD_YOUR_OWN_DOSA }), faqPageSchema("/menu/", menuFaq)],
});
---

<Base title={title} description={description} path="/menu/" schema={schema}>
  <Nav homeBase={base} />
  <main id="main">
    <section class="section menu-page__head">
      <div class="container">
        <p class="eyebrow">Menu</p>
        <h1 class="section__title">{name} Menu</h1>
        <p class="section__lead">
          {name} is a {getFact("type")} in Anna Nagar East, Chennai, serving {getFact("mealTimes")} every day from {range}.
          This page lists all {itemCount} dishes on the current menu{allVegetarian ? ", every one of them vegetarian" : ""}.
        </p>
        <p class="menu-page__note">Prices in {currencySymbol === "₹" ? "Indian rupees (₹)" : currencySymbol}, as on the current menu. {menuNotes.gst} {menuNotes.parcel} {menuNotes.prep}</p>
        <p>
          <a href={`${base}#visit`}>Visit us</a> ·
          <a href={`${base}#contact`}>Contact</a>
        </p>
      </div>
    </section>

    <BuildYourOwnDosa />

    <section class="section section--tint" id="price-table" aria-labelledby="price-table-title">
      <div class="container">
        <h2 class="section__title" id="price-table-title">Menu prices by category</h2>
        <table class="menu-page__table">
          <caption class="visually-hidden">Number of dishes and price range for each menu category</caption>
          <thead>
            <tr>
              <th scope="col">Category</th>
              <th scope="col">Dishes</th>
              <th scope="col">Price range</th>
              <th scope="col">Lowest priced</th>
              <th scope="col">Highest priced</th>
            </tr>
          </thead>
          <tbody>
            {
              categories.map((c) => (
                <tr>
                  <th scope="row"><a href={`#${c.id}`}>{c.name}</a></th>
                  <td>{c.count}</td>
                  <td>{priceRange(c)}</td>
                  <td>{c.cheapest.name} ({rupees(c.cheapest.price)})</td>
                  <td>{c.dearest.name} ({rupees(c.dearest.price)})</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      categories.map((c) => (
        <section class="section" id={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="container">
            <h2 class="section__title" id={`${c.id}-title`}>{c.name}</h2>
            {c.blurb && <p class="section__lead">{c.blurb}</p>}
            <ul class="menu-page__list" role="list">
              {c.items.map((item) => (
                <li class="menu-page__item">
                  <p class="menu-page__row">
                    <strong class="menu-page__name">{item.name}</strong>
                    <span class="menu-page__price">{rupees(item.price)}</span>
                  </p>
                  <p class="menu-page__desc">
                    {item.diet === "veg" ? "Vegetarian. " : ""}
                    {item.description}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    {extras.length > 0 && (
      <section class="section section--tint" id="signature-specials" aria-labelledby="signature-title">
        <div class="container">
          <h2 class="section__title" id="signature-title">Signature specials</h2>
          <p class="section__lead">Ask at the restaurant for today's price.</p>
          <ul class="menu-page__list" role="list">
            {extras.map((e) => (
              <li><p class="menu-page__row"><strong class="menu-page__name">{e.name}</strong></p><p class="menu-page__desc">{e.note.charAt(0).toUpperCase() + e.note.slice(1)}.</p></li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <Faq items={menuFaq} title="Menu questions" lead="" eyebrow="Questions" />

    <AtAGlance />
  </main>
  <Footer homeBase={base} />
</Base>
