---
/**
 * Home: brand hub, following the on-page blueprint of 2026-11-11. Required H2s,
 * in order: Customized Dosa, Your Way (was "Build Your Own Dosa, Your Way"; client
 * direction 2026-11-13); Lunch; Dinner Until 11 PM; Catering for Offices and Events;
 * Why Guests Choose Brihadhee; What Guests Say; Visit Us in Anna Nagar; Quick
 * Answers. The full menu (every dish in the HTML, checked by aeo-lint and verify),
 * offers and gallery sit between "Why" and "What Guests Say". Contact and Careers
 * (client direction 2026-11-13) close the page.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AtAGlance from "../components/AtAGlance.astro";
import ContentSection from "../components/ContentSection.astro";
import About from "../components/About.astro";
import Offers from "../components/Offers.astro";
import MenuSection from "../components/MenuSection.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import Visit from "../components/Visit.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import Careers from "../components/Careers.astro";
import Footer from "../components/Footer.astro";
import KolamDivider from "../components/KolamDivider.astro";
import { homePage as page } from "../data/pages.js";
import { ROUTES, href } from "../data/site.js";
---

<Base
  title={page.title}
  description={page.description}
  ogDescription={`Brihadhee: dosas made your way, claypot Paanai Parotta, Nellai sodhi meals and filter coffee. Pure veg lunch and dinner on 3rd Avenue, Anna Nagar East.`}
>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero h1={page.h1} />
    <AtAGlance rows={page.glance} />
    <ContentSection {...page.byo} />
    <ContentSection {...page.lunch} />
    <ContentSection {...page.dinner} />
    {page.catering && <ContentSection {...page.catering} />}
    <KolamDivider />
    <About />
    <MenuSection />
    <Offers />
    <Gallery />
    <Reviews />
    <Visit />
    <KolamDivider />
    <Faq title="Quick Answers" eyebrow="FAQ" moreHref={href(ROUTES.faq)} />
    <Contact />
    <Careers />
  </main>
  <Footer />
</Base>
