---
/**
 * /about/: merged About and Contact page: address, directions from Anna Nagar
 * landmarks, opening hours, the founders' story and the name story. Primary
 * intent: "brihadhee address", "brihadhee timings", "brihadhee contact number".
 * All facts come from entity-truth.ts. Directions are Google Maps links from each
 * landmark; no distance or travel time is stated (none is verified).
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import AtAGlance from "../components/AtAGlance.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import LeadForm from "../components/LeadForm.astro";
import { getFact, addressLine, landmarkSentence, clock, openingTimes } from "../data/entity-truth.ts";
import { aboutFaq } from "../data/faq.js";
import { cateringEnabled } from "../data/catering.js";
import { pageGraph, faqPageSchema, HOME_CRUMBS } from "../lib/schema.js";
import { site, telHref, emailHref, hasHours, directionsFrom, ROUTES, href } from "../data/site.js";

const name = getFact("name");
const street = getFact("street");
const hours = site.hours;
const phone = getFact("phone");
const email = getFact("email");
const founders = getFact("founders");
const landmark = getFact("landmarks")[0];
const { range } = openingTimes();
const path = ROUTES.about;
const title = `${name} Anna Nagar: Address, Timings & Contact`;
const description = `Visit ${name} on ${street}, near ${landmark}. Open daily ${range}. Get directions or call ${phone}.`;
const schema = pageGraph({
  path,
  title,
  description,
  crumbs: [...HOME_CRUMBS, { name: "Address, timings and contact", path }],
  extras: [faqPageSchema(path, aboutFaq)],
});
---

<Base title={title} description={description} path={path} schema={schema}>
  <Nav homeBase={href("/")} />
  <main id="main" tabindex="-1">
    <PageHeader
      eyebrow="Address, timings and contact · Anna Nagar East"
      h1={`Visit ${name} in Anna Nagar`}
      intro={`${name} is a 100% pure vegetarian restaurant at ${addressLine()}, near ${landmark}, open every day from ${range} for ${getFact("mealTimes")}.`}
      menuHref={href(ROUTES.menu)}
      primaryAction={{ label: "Address and landmark directions", href: "#find-us" }}
    />
    <AtAGlance />

    <section class="section" id="find-us" aria-labelledby="find-us-title">
      <div class="container dish-page__grid">
        <div>
          <h2 class="section__title" id="find-us-title">Address and Directions from Anna Nagar Landmarks</h2>
          <p class="section__lead">
            {name} is at {addressLine()}, near {landmark}. Pick the landmark you are starting from for Google Maps directions.
          </p>
          <address class="catering__address">
            {site.address.line1}<br />
            {site.address.line2}<br />
            {site.address.city}, {site.address.state} {site.address.postalCode}
          </address>
          <p>Landmarks: {landmarkSentence()}.</p>
          <ul class="link-list" role="list">
            {getFact("directionLandmarks").map(({ label, query, travelMode }) => (
              <li>
                <a href={directionsFrom(query, travelMode)} target="_blank" rel="noopener">
                  {travelMode === "walking" ? "Walking directions" : "Directions"} from {label}
                </a>
              </li>
            ))}
          </ul>
          <p>
            Restaurant phone: <a href={telHref}>{phone}</a> · Email: <a href={emailHref}>{email}</a>
          </p>
          {cateringEnabled && <p>For off-site events, <a href={href(ROUTES.eventCatering)}>contact the catering team</a>.</p>}
          <div class="page-head__actions">
            <a class="btn btn--primary" href={site.maps.directions} target="_blank" rel="noopener">
              <Icon name="navigation" size={17} /> Get directions in Google Maps
            </a>
            <a class="btn btn--ghost" href={telHref}>
              <Icon name="phone" size={17} /> Call {phone}
            </a>
          </div>
        </div>
        <div class="visit__map">
          <iframe src={site.maps.embed} title={`Map showing ${name} on ${street}, Chennai`} width="600" height="450" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <section class="section" id="arrival" aria-labelledby="arrival-title">
      <div class="container">
        <h2 class="section__title" id="arrival-title">Before you arrive</h2>
        <p class="section__lead">
          If you need step-free entry, room for a mobility aid, a drop-off point or parking information, <a href={telHref}>call {phone}</a> before your visit so the restaurant can check what is available.
        </p>
      </div>
    </section>

    <section class="section section--tint" id="hours" aria-labelledby="hours-title">
      <div class="container">
        <h2 class="section__title" id="hours-title">Opening Hours</h2>
        <p class="section__lead">
          {name} is open every day, Monday to Sunday, from {range}, serving {getFact("mealTimes")}. For a table, call
          <a href={telHref}>{phone}</a> or <a href={href(ROUTES.book)}>see table booking options</a>.
          If you're arriving late, call ahead to check when the kitchen takes its last orders.
          See <a href={href(ROUTES.whatsNew)}>what's new at {name}</a> for recent changes.
        </p>
        {hasHours && (
          <table class="menu-page__table">
            <caption class="visually-hidden">{name} opening hours for each day</caption>
            <tbody>
              {hours.days.map((d) => (
                <tr><th scope="row">{d.day}</th><td>{clock(d.open)} to {clock(d.close)}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </section>

    <section class="section" id="story" aria-labelledby="story-title">
      <div class="container">
        <h2 class="section__title" id="story-title">Our Story: Founded by {founders.names.join(" and ")}</h2>
        <p class="section__lead">{founders.story}</p>
        <p>
          Today {name} serves {getFact("recipeStory")} at its pure vegetarian restaurant on {street}.
          Try the <a href={href(ROUTES.lunch)}>Nellai Special Sodhi Meals</a> or see
          <a href={href(ROUTES.dosa)}>how to customize a dosa</a>.
        </p>
      </div>
    </section>

    <section class="section section--tint" id="name" aria-labelledby="name-title">
      <div class="container">
        <h2 class="section__title" id="name-title">The Meaning Behind the Name {name}</h2>
        <p class="section__lead">{getFact("nameStory")}</p>
        <p class="tamil" lang="ta">{getFact("nameTamil")}: அண்ணா நகர் கிழக்கு, சுத்த சைவ உணவகம்.</p>
      </div>
    </section>

    <Faq items={aboutFaq} title="Location and visiting questions" lead="" eyebrow="Questions" moreHref={href(ROUTES.faq)} />
    <LeadForm
      variant="general"
      page={path}
      title="Send a restaurant enquiry"
      lead={`Ask the ${name} restaurant about a group visit or the menu. For a table today, call or WhatsApp.`}
    />
  </main>
  <Footer homeBase={href("/")} />
</Base>
