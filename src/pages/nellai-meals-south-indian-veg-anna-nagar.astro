---
/**
 * Pillar 1 regional-specialty page: Nellai (Tirunelveli) sodhi meals,
 * Karupatti Ulundhu Kali, Karaikudi dishes and the lunch meals (lunch page).
 * Prices come from menu-canonical.ts; offers from entity-truth.ts.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import AtAGlance from "../components/AtAGlance.astro";
import Offers from "../components/Offers.astro";
import Faq from "../components/Faq.astro";
import { nellaiPage as page, signatureMenu as m } from "../data/pages.js";
import { rupees } from "../lib/menu-facts.js";
import { getFact } from "../data/entity-truth.ts";
import { pageGraph, faqPageSchema, HOME_CRUMBS } from "../lib/schema.js";
import { site, responsive } from "../data/site.js";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const schema = pageGraph({
  path: page.path,
  title: page.title,
  description: page.description,
  crumbs: [...HOME_CRUMBS, { name: "Nellai meals", path: page.path }],
  extras: [faqPageSchema(page.path, page.faq)],
});
---

<Base title={page.title} description={page.description} path={page.path} schema={schema}>
  <Nav homeBase={base} />
  <main id="main">
    <PageHeader eyebrow="Tirunelveli and Karaikudi · Anna Nagar East" h1={page.h1} intro={page.intro} menuHref={`${base}menu/`} />
    <AtAGlance title="Nellai meals at Brihadhee: summary" rows={page.glance} />

    <section class="section" id="sodhi-meals" aria-labelledby="sodhi-title">
      <div class="container dish-page__grid">
        <article>
          <h2 class="section__title" id="sodhi-title">{page.sodhi.name}, {page.sodhi.price}</h2>
          <p>Brihadhee's Tirunelveli-style sodhi meal is served with:</p>
          <ul class="dish-list dish-list--cols" role="list">
            {page.sodhi.parts.map((p) => <li>{p.charAt(0).toUpperCase() + p.slice(1)}</li>)}
          </ul>
          <p>
            Sodhi also comes with idiyappam as {m.idiyappamSodhi.name} ({rupees(m.idiyappamSodhi.price)}).
          </p>
        </article>
        <figure class="dish-page__photo">
          <img {...responsive("meals", 1200)} sizes="(max-width: 900px) 92vw, 45vw" width="1200" height="900" loading="lazy" decoding="async"
            alt="South Indian vegetarian meal with rice and sides on a banana leaf at Brihadhee, Anna Nagar East" />
          <figcaption>Meals from the Brihadhee kitchen</figcaption>
        </figure>
      </div>
    </section>

    <section class="section section--tint" id="specialties" aria-labelledby="specialties-title">
      <div class="container">
        <h2 class="section__title" id="specialties-title">Regional specialties and lunch meals</h2>
        <ul class="dish-list dish-list--cols" role="list">
          <li><strong>{m.kali.name}</strong> <span>{rupees(m.kali.price)}</span><br /><small>{m.kali.description}</small></li>
          <li><strong>{m.poppers.name}</strong> <span>{rupees(m.poppers.price)}</span><br /><small>{m.poppers.description}</small></li>
          {m.lunch.items.filter((i) => i.name !== m.sodhiMeals.name).slice(0, 3).map((i) => (
            <li><strong>{i.name}</strong> <span>{rupees(i.price)}</span><br /><small>{i.description}</small></li>
          ))}
          <li><strong>{m.combo.name}</strong> <span>{rupees(m.combo.price)}</span><br /><small>{m.combo.description}</small></li>
        </ul>
      </div>
    </section>

    <Offers />
    <Faq items={page.faq} title="Nellai meals and lunch questions" lead="Direct answers about Tirunelveli and Karaikudi dishes at Brihadhee." eyebrow="Questions" />

    <section class="section" id="more" aria-labelledby="more-title">
      <div class="container">
        <h2 class="section__title" id="more-title">More from Brihadhee</h2>
        <ul class="link-list" role="list">
          <li><a href={`${base}menu/`}>Full menu with prices</a></li>
          <li><a href={`${base}best-dosa-parotta-anna-nagar/`}>Build-your-own dosas and Paanai Parotta</a></li>
          <li><a href={`${base}#visit`}>Find us on {site.address.line1}</a></li>
        </ul>
      </div>
    </section>
  </main>
  <Footer homeBase={base} />
</Base>
