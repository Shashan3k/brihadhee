---
/**
 * /book-a-table/: how to reserve. Brihadhee takes pre-bookings through partner
 * apps (Swiggy Dineout, EazyDiner, District), so there is no booking form here:
 * a form without a confirmed endpoint would lose bookings. The page says so, and
 * says a group can confirm seating by phone (AEO audit 2026-11-12: whether a
 * request is an instant booking was unclear). Q&A: bookingFaq in src/data/faq.js. Offers come from
 * entity-truth.ts (owner-confirmed; re-check monthly). Only partner URLs in
 * FACTS.bookingLinks are linked; the others are named.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { getFact } from "../data/entity-truth.ts";
import Faq from "../components/Faq.astro";
import { pageGraph, faqPageSchema, HOME_CRUMBS } from "../lib/schema.js";
import { ROUTES, href, telHref } from "../data/site.js";
import { bookingFaq } from "../data/faq.js";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const name = getFact("name");
const phone = getFact("phone");
const offers = getFact("offers");
const offer = (id) => {
  const o = offers.find((x) => x.id === id);
  if (!o) throw new Error(`[book-a-table] offer "${id}" missing in entity-truth.ts`);
  return o;
};
const walkIn = offer("walk-in");
const preBook = offer("pre-booking");
const links = getFact("bookingLinks");
const walkInPct = walkIn.description.match(/\d+%/)?.[0];
if (!walkInPct) throw new Error("[book-a-table] walk-in offer percentage not found in entity-truth.ts");
const linked = new Set(links.map((l) => l.label));
const partners = ["Swiggy Dineout", "EazyDiner", "District"];
const unlinked = partners.filter((p) => !linked.has(p));
const partnerList = `${partners.slice(0, -1).join(", ")} or ${partners.at(-1)}`;

const path = "/book-a-table/";
const title = `Book a Table at ${name}, Anna Nagar East`;
const description = `Book lunch or dinner at ${name}, Anna Nagar East, through Swiggy Dineout, EazyDiner or District. Call the restaurant for group seating.`;
const schema = pageGraph({
  path,
  title,
  description,
  crumbs: [...HOME_CRUMBS, { name: "Book a table", path }],
  extras: [faqPageSchema(path, bookingFaq)],
});
---

<Base title={title} description={description} path={path} schema={schema}>
  <Nav homeBase={base} />
  <main id="main" tabindex="-1">
    <PageHeader
      eyebrow="Reservations · Anna Nagar East"
      h1={`Book a table at ${name}, Anna Nagar East`}
      intro={`Choose a booking partner to reserve a table for ${getFact("mealTimes")} at ${name}. The partner shows your booking status. For a group table, call ${phone} so the restaurant can check seating.`}
      menuHref={href(ROUTES.menu)}
      primaryAction={{ label: "Choose a booking partner", href: "#how-to-book" }}
    />

    <section class="section section--tint" id="how-to-book" aria-labelledby="how-title">
      <div class="container">
        <h2 class="section__title" id="how-title">How to book a table</h2>
        <p class="section__lead">
          Book {name} in Anna Nagar East through {partnerList}. Choose your date, time and party size, then
          check your booking status in the app before you travel. Show the booking at the counter when you arrive.
        </p>
        <div class="page-head__actions">
          {links.map((l) => (
            <a class="btn btn--primary" href={l.url} target="_blank" rel="noopener" data-event="book_table_click">
              <Icon name="clock" size={17} /> Book on {l.label}
            </a>
          ))}
          <a class="btn btn--ghost" href={telHref}>
            <Icon name="phone" size={17} /> Call {phone}
          </a>
        </div>
        {unlinked.length > 0 && (
          <p>Also available on {unlinked.join(" and ")}: search for {name} in the app.</p>
        )}
        <p class="section__lead">
          Dining offers include {preBook.description} and {walkInPct} off for walk-in dine-in.
          Check the offer shown for your slot in the booking app.
        </p>
      </div>
    </section>

    <section class="section" id="groups" aria-labelledby="groups-title">
      <div class="container">
        <h2 class="section__title" id="groups-title">Large groups and functions</h2>
        <p class="section__lead">
          For a large family group, <a href={telHref}>call {phone}</a> with your date, time and party size so the team can
          check seating. For functions of 50 guests or more at your own venue, see
          <a href={`${base}catering-services-chennai/`}>{name} catering</a>.
        </p>
        <p>
          Browse the <a href={href(ROUTES.menu)}>menu and prices</a>, see
          <a href={href(ROUTES.familyDining)}>family dining options</a> or check
          <a href={`${href(ROUTES.about)}#find-us`}>the address and directions</a> before you visit.
        </p>
      </div>
    </section>
    <Faq items={bookingFaq} title="Table booking questions" lead="Direct answers about reserving a table at Brihadhee, Anna Nagar East." eyebrow="Questions" />
  </main>
  <Footer homeBase={base} />
</Base>
