---
/**
 * Build Your Own Dosa: the steps and the chef's suggestions, exactly as on page 1
 * of the menu (src/data/menu-canonical.ts), with the guest-facing step headings
 * from src/lib/menu-facts.js. Static HTML, no JavaScript.
 *
 *   show="all"          heading, steps, then the suggestions as a sub-section (/menu/)
 *   show="steps"        heading and steps only (/menu/dosa/ "How It Works")
 *   show="suggestions"  heading and suggestions only (/menu/dosa/ combinations)
 */
import { byo, rupees } from "../lib/menu-facts.js";

const {
  id = "build-your-own-dosa",
  headingLevel = 2,
  title = "Build Your Own Dosa",
  lead = `Pick one batter, then add podi and toppings, a filling and your roast. Batters start at ${rupees(byo.batterMin)}; each add-on is priced separately.`,
  show = "all",
  suggestionsTitle = "Chef's suggestions",
  tint = false,
} = Astro.props;
const H = `h${headingLevel}`;
const Sub = `h${headingLevel + 1}`;
const showSteps = show !== "suggestions";
const showSuggestions = show !== "steps";
const SuggestionHeading = show === "suggestions" ? H : Sub;
---

<section class={`section byo${tint ? " section--tint" : ""}`} id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    {show === "suggestions" ? (
      <SuggestionHeading class="section__title" id={`${id}-title`}>{suggestionsTitle}</SuggestionHeading>
    ) : (
      <H class="section__title" id={`${id}-title`}>{title}</H>
    )}
    {lead && <p class="section__lead">{lead}</p>}

    {showSteps && (
      <ol class="byo__steps">
        {byo.steps.map((s) => (
          <li class="byo__step">
            <Sub class="byo__step-title">Step {s.step}: {s.label}</Sub>
            <p class="byo__step-text">{s.text}</p>
            <ul class="byo__options" role="list">
              {s.options.map((o) => (
                <li class="byo__option">
                  <span>
                    <strong>{o.name}</strong>
                    {o.note && <small> ({o.note})</small>}
                  </span>
                  <span class="byo__price">{s.step === 1 ? rupees(o.price) : `+${rupees(o.price)}`}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    )}

    {showSuggestions && (
      <>
        {show === "all" && <SuggestionHeading class="byo__subhead">{suggestionsTitle}</SuggestionHeading>}
        <ul class="byo__suggestions" role="list">
          {byo.suggestions.map((d) => (
            <li class="byo__suggestion">
              <p class="byo__row"><strong>{d.name}</strong> <span class="byo__price">{rupees(d.price)}</span></p>
              <p class="byo__build">{d.build.join(", ")}</p>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>
