---
/** A quiet kolam-inspired band used to separate sections. */
const { tone = "default", class: className = "" } = Astro.props;
const tiles = [0, 1, 2, 3, 4, 5];
---

<div
  class:list={["kolam-divider", tone === "ink" && "kolam-divider--ink", className]}
  aria-hidden="true"
>
  <svg viewBox="0 0 240 26" focusable="false">
    {
      tiles.map((i) => (
        <g transform={`translate(${i * 40} 1)`} stroke="currentColor" fill="none" stroke-width="1.1">
          <circle cx="4" cy="12" r="1.4" fill="currentColor" stroke="none" />
          <circle cx="36" cy="12" r="1.4" fill="currentColor" stroke="none" />
          <path d="M20 4.5c3.1 3 3.1 12 0 15-3.1-3-3.1-12 0-15Z" />
          <path d="M12.5 12c3-3.1 12-3.1 15 0-3 3.1-12 3.1-15 0Z" />
          <circle cx="20" cy="12" r="1.5" fill="currentColor" stroke="none" />
        </g>
      ))
    }
  </svg>
</div>
