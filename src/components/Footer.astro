---
import {
  site,
  hasPhone,
  hasWhatsApp,
  hasEmail,
  hasHoursText,
  socialLinks,
  telHref,
  whatsappHref,
  emailHref,
  ROUTES,
  href,
} from "../data/site.js";
import Icon from "./Icon.astro";
import { getFact } from "../data/entity-truth.ts";

// Confirmed listings only (entity-truth.ts). Swiggy, Zomato, District and Justdial
// are added here once the owner confirms each URL.
const listings = [
  { label: "Google Maps", href: getFact("mapUrl") },
  ...getFact("bookingLinks").map((b) => ({ label: `Book on ${b.label}`, href: b.url })),
];

const { homeBase = "" } = Astro.props;
const link = (href) => (href.startsWith("#") ? `${homeBase}${href}` : href);
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const address = site.address;
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__about">
        <a class="brand" href={link("#top")} aria-label={`${site.name} — back to top`}>
          <img
            class="brand__logo"
            src={`${base}images/logo.webp`}
            width="594"
            height="420"
            alt={site.name}
          />
        </a>
        <p>{site.shortDescription}</p>

        {
          socialLinks.length > 0 && (
            <div class="footer__social">
              {socialLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${site.name} on ${link.key}`}
                >
                  <Icon name={link.key} size={18} />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <nav aria-labelledby="footer-explore">
        <p class="footer__title" id="footer-explore">Explore</p>
        <ul class="footer__links" role="list">
          {site.navigation.flatMap((item) => item.children ?? [item]).map((item) => (
            <li><a href={link(item.href)}>{item.label}</a></li>
          ))}
          <li><a href={`${base}book-a-table/`}>Book a Table</a></li>
          <li><a href={href(ROUTES.familyDining)}>Family Dining</a></li>
          <li><a href={href(ROUTES.faq)}>FAQ</a></li>
          <li><a href={`${base}guides/what-are-nellai-meals/`}>Guide: What Are Nellai Meals?</a></li>
          <li><a href={`${base}whats-new/`}>What's New</a></li>
          <li><a href={`${base}seasonal/karthigai-ayyappa-pure-veg/`}>Karthigai &amp; Ayyappa Mala</a></li>
          <li><a href={`${base}privacy/`}>Privacy</a></li>
        </ul>
      </nav>

      <div>
        <p class="footer__title">Visit</p>
        <address class="footer__address">
          {address.line1}<br />
          {address.line2}<br />
          {address.city}, {address.state}{address.postalCode ? ` ${address.postalCode}` : ""}
        </address>
        {
          hasHoursText && (
            <p class="footer__hours">{site.hours.summary}</p>
          )
        }
      </div>

      <div>
        <p class="footer__title">Contact</p>
        <ul class="footer__links" role="list">
          {hasPhone && <li><a href={telHref}>{site.contact.phone}</a></li>}
          {hasWhatsApp && <li><a href={whatsappHref}>WhatsApp</a></li>}
          {hasEmail && <li><a href={emailHref}>{site.contact.email}</a></li>}
          <li>
            <a href={site.maps.directions} target="_blank" rel="noopener" data-event="directions_click">
              Get directions
            </a>
          </li>
          {listings.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>South Indian restaurant · Anna Nagar East, Chennai</p>
      <p>Also searched as Brihadhi, Brihadee, Bruhadhee, Brahadhee</p>
      <p><a href={link("#top")}>Back to top ↑</a></p>
    </div>
  </div>
</footer>
