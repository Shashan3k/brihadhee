---
/**
 * Sticky mobile CTA bar (hidden from 900px up): Call | WhatsApp | Book / Quote.
 * Rendered by Base.astro on every page. Catering pages pass mode="quote", which
 * turns the third button into "Get a quote" (jumps to the page's #enquiry form).
 * Taps fire the GA4 events click_call, click_whatsapp, book_table_view_click and
 * quote_cta_click (src/scripts/main.js).
 */
import { site, ROUTES, href, pageContact } from "../data/site.js";
import Icon from "./Icon.astro";

const { mode = "book", quoteAction } = Astro.props;
const quote = mode === "quote";
const { hasPhone, hasWhatsApp, telHref, whatsappHref } = pageContact(Astro);
---

<nav class="callbar is-visible" id="callbar" aria-label="Quick actions">
  {hasPhone && (
    <a href={telHref} data-event="click_call">
      <Icon name="phone" size={19} />
      Call
    </a>
  )}
  {hasWhatsApp && (
    <a href={`${whatsappHref}?text=${encodeURIComponent(`Hi ${site.name}, `)}`} target="_blank" rel="noopener" data-event="click_whatsapp">
      <Icon name="whatsapp" size={19} />
      WhatsApp
    </a>
  )}
  {quote ? (
    <a href={quoteAction?.href ?? "#enquiry"} data-event="quote_cta_click" data-primary>
      <Icon name="mail" size={19} />
      {quoteAction?.shortLabel ?? quoteAction?.label ?? "Get a quote"}
    </a>
  ) : (
    <a href={href(ROUTES.book)} data-event="book_table_view_click" data-primary>
      <Icon name="utensils" size={19} />
      Book a table
    </a>
  )}
</nav>
