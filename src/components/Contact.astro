---
import {
  site,
  hasPhone,
  hasWhatsApp,
  hasEmail,
  hasHoursText,
  telHref,
  whatsappHref,
  emailHref,
} from "../data/site.js";
import Icon from "./Icon.astro";

const hasChannels = hasPhone || hasWhatsApp || hasEmail;
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__grid">
      <div class="reveal">
        <p class="eyebrow">Contact</p>
        <h2 class="section__title" id="contact-title">Come in, or say hello</h2>
        <p class="section__lead">
          Questions about the menu, a table for a group, or a celebration? Reach
          out — we are happy to help.
        </p>

        <ul class="contact__channels" role="list">
          {
            hasPhone && (
              <li>
                <a class="contact__channel" href={telHref}>
                  <Icon name="phone" />
                  <span>
                    <span>Call us</span>
                    <strong>{site.contact.phone}</strong>
                  </span>
                </a>
              </li>
            )
          }
          {
            hasWhatsApp && (
              <li>
                <a
                  class="contact__channel"
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="whatsapp" />
                  <span>
                    <span>WhatsApp</span>
                    <strong>{site.contact.whatsapp}</strong>
                  </span>
                </a>
              </li>
            )
          }
          {
            hasEmail && (
              <li>
                <a class="contact__channel" href={emailHref}>
                  <Icon name="mail" />
                  <span>
                    <span>Email</span>
                    <strong>{site.contact.email}</strong>
                  </span>
                </a>
              </li>
            )
          }
          {
            !hasChannels && (
              <li>
                <a
                  class="contact__channel"
                  href={site.maps.directions}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="pin" />
                  <span>
                    <span>Find us</span>
                    <strong>{site.fullAddress}</strong>
                  </span>
                </a>
              </li>
            )
          }
        </ul>

        <p class="contact__note">
          Walk-ins are welcome. For directions, use the map in
          <a href="#visit">Visit us</a>.
        </p>
      </div>

      {
        (
          <div
            class="visit__card contact__visit reveal"
            style="--reveal-delay:100ms"
          >
            <p class="visit__label">Plan your visit</p>
            {hasHoursText && <p class="contact__hours">{site.hours.summary}</p>}
            <ul class="visit__amenities" role="list">
              {site.amenities.map((item) => (
                <li>
                  <strong>{item.label}</strong>
                  <span>{item.detail}</span>
                </li>
              ))}
            </ul>
            <div class="visit__actions">
              <a
                class="btn btn--ghost"
                href={site.maps.directions}
                target="_blank"
                rel="noopener"
              >
                <Icon name="navigation" size={17} />
                Get directions
              </a>
              <a class="btn btn--primary" href="/about/#enquiry">
                <Icon name="mail" size={17} />
                Send an enquiry
              </a>
            </div>
          </div>
        )
      }

    </div>
  </div>
</section>
