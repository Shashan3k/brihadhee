---
import { site, pageContact } from "../data/site.js";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
import Icon from "./Icon.astro";

// On sub-pages (e.g. /catering) in-page anchors must point back to the home page.
const { homeBase = "" } = Astro.props;
const { phone, hasPhone, telHref } = pageContact(Astro);
const link = (href) => (href.startsWith("#") ? `${homeBase}${href}` : href);

/* Dropdowns (site.navigation items with `children`) are <details> elements, so they
   open without JavaScript; src/scripts/main.js closes them on outside click and Escape.
   Children marked `group: "categories"` (the menu categories) get their own
   two-column list under the main links. */
const split = (children) => ({
  main: children.filter((c) => !c.group),
  categories: children.filter((c) => c.group === "categories"),
});

// Mark the link for the page being viewed (hash links are sections, never "the page").
const here = Astro.url.pathname.replace(/\/?$/, "/");
const isHere = (href) => !href.includes("#") && href.replace(/\/?$/, "/") === here;
const current = (href) => (isHere(href) ? "page" : undefined);
const groupIsHere = (item) => item.children.some((c) => isHere(c.href));
---

<header class="site-header" id="site-header">
  <div class="container nav">
    <a class="brand" href={`${homeBase}#top`} aria-label={`${site.name} — home`}>
      <img
        class="brand__logo"
        src={`${base}images/logo.webp`}
        width="594"
        height="420"
        alt={site.name}
      />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        site.navigation.map((item) => {
          if (!item.children) return <a href={link(item.href)} aria-current={current(item.href)}>{item.label}</a>;
          const { main, categories } = split(item.children);
          return (
            <details class:list={["nav__group", groupIsHere(item) && "is-current"]} data-nav-group>
              <summary>{item.label}</summary>
              <div class:list={["nav__menu", categories.length > 0 && "nav__menu--wide"]}>
                {main.map((c) => (
                  <a class="nav__menu-main" href={link(c.href)} aria-current={current(c.href)}>
                    {c.label}
                  </a>
                ))}
                {categories.length > 0 && (
                  <div class="nav__menu-grid" role="group" aria-label={`${item.label} categories`}>
                    {categories.map((c) => (
                      <a href={link(c.href)}>{c.label}</a>
                    ))}
                  </div>
                )}
              </div>
            </details>
          );
        })
      }
    </nav>

    <div class="nav__actions">
      {
        hasPhone && (
          <a class="btn btn--primary btn--sm" href={telHref}>
            <Icon name="phone" size={16} />
            <span>Call now</span>
          </a>
        )
      }
      <a class="nav__fallback" href="#footer-explore">Menu</a>
      <button
        class="nav__toggle"
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>

  <div class="nav__panel" id="nav-panel" hidden>
    {
      site.navigation.map((item) => {
        if (!item.children)
          return (
            <a class="nav__panel-link" href={link(item.href)} aria-current={current(item.href)}>
              {item.label}
              <Icon name="arrowUpRight" size={16} />
            </a>
          );
        const { main, categories } = split(item.children);
        return (
          <details class:list={["nav__panel-group", groupIsHere(item) && "is-current"]} data-nav-group>
            <summary>{item.label}</summary>
            <div class="nav__panel-links">
              {main.map((c) => (
                <a href={link(c.href)} aria-current={current(c.href)}>
                  {c.label}
                  <Icon name="arrowUpRight" size={16} />
                </a>
              ))}
              {categories.length > 0 && (
                <div class="nav__panel-grid" role="group" aria-label={`${item.label} categories`}>
                  {categories.map((c) => (
                    <a href={link(c.href)}>{c.label}</a>
                  ))}
                </div>
              )}
            </div>
          </details>
        );
      })
    }
    {
      hasPhone && (
        <a class="btn btn--primary" href={telHref}>
          <Icon name="phone" size={17} />
          Call {phone}
        </a>
      )
    }
  </div>
</header>
