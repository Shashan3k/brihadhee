---
import { site, hasPhone, telHref } from "../data/site.js";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
import Icon from "./Icon.astro";

// On sub-pages (e.g. /catering) in-page anchors must point back to the home page.
const { homeBase = "" } = Astro.props;
const link = (href) => (href.startsWith("#") ? `${homeBase}${href}` : href);
---

<header class="site-header" id="site-header">
  <div class="container nav">
    <a class="brand" href={`${homeBase}#top`} aria-label={`${site.name} — home`}>
      <img
        class="brand__logo"
        src={`${base}images/logo.webp`}
        width="594"
        height="420"
        alt={site.name}
      />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {site.navigation.map((item) =>
        item.children ? (
          <details class="nav__group" data-nav-group>
            <summary>{item.label}</summary>
            <div class="nav__menu">
              {item.children.map((c) => <a href={link(c.href)}>{c.label}</a>)}
            </div>
          </details>
        ) : (
          <a href={link(item.href)}>{item.label}</a>
        )
      )}
    </nav>

    <div class="nav__actions">
      {
        hasPhone && (
          <a class="btn btn--primary btn--sm" href={telHref}>
            <Icon name="phone" size={16} />
            <span>Call now</span>
          </a>
        )
      }
      <button
        class="nav__toggle"
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>

  <div class="nav__panel" id="nav-panel" hidden>
    {
      site.navigation.map((item) =>
        item.children ? (
          <div class="nav__panel-group" role="group" aria-label={item.label}>
            <p class="nav__panel-label">{item.label}</p>
            {item.children.map((c) => (
              <a href={link(c.href)}>
                {c.label}
                <Icon name="arrowUpRight" size={16} />
              </a>
            ))}
          </div>
        ) : (
          <a href={link(item.href)}>
            {item.label}
            <Icon name="arrowUpRight" size={16} />
          </a>
        )
      )
    }
    {
      hasPhone && (
        <a class="btn btn--primary" href={telHref}>
          <Icon name="phone" size={17} />
          Call {site.contact.phone}
        </a>
      )
    }
  </div>
</header>
