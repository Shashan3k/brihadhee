---
/**
 * Reviews. No paraphrased or unattributed quotes: testimonials render only
 * when the owner adds real, dated, permissioned entries to site.testimonials,
 * and the rating card only when googleRating is confirmed in entity-truth.ts.
 * Until then this is an honest empty state that sends guests to Google.
 */
import { site } from "../data/site.js";
import { getFact } from "../data/entity-truth.ts";
import Stars from "./Stars.astro";

const { rating, testimonials } = site;
const mapUrl = getFact("mapUrl");
---

<section class="section section--tint" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Reviews</p>
      <h2 class="section__title" id="reviews-title">Read or leave a review of {site.name}</h2>
    </div>

    <div class="reviews__grid">
      <aside class="review-card on-dark reveal" aria-label={rating ? "Google rating summary" : "Where to find reviews"}>
        {
          rating ? (
            <>
              <p class="review-card__label">{rating.source} rating</p>
              <p class="review-card__score">
                <span class="rating__value">{rating.value}</span>
                <small>out of 5</small>
              </p>
              <div class="review-card__stars">
                <Stars value={rating.value} size={16} />
              </div>
              <p class="review-card__count">
                Based on {rating.count.toLocaleString("en-IN")} {rating.source} reviews
                {rating.checkedOn && ` (checked ${rating.checkedOn})`}
              </p>
            </>
          ) : (
            <p class="review-card__label">Reviews live on Google Maps</p>
          )
        }
        <p class="review-card__note">
          <a href={mapUrl} target="_blank" rel="noopener">Open {site.name} on Google Maps</a>
        </p>
      </aside>

      <div class="reveal" style="--reveal-delay:100ms">
        {
          testimonials.length > 0 ? (
            <div class="testimonials">
              {testimonials.map((item) => (
                <figure class="testimonial">
                  <blockquote>
                    <p>{item.quote}</p>
                  </blockquote>
                  <figcaption>
                    <strong>{item.name}</strong>
                    {item.meta}
                  </figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <p class="reviews__lead">
              Ate with us recently? A short review on Google Maps that names the dish you had helps other
              families find {site.name}.
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
