---
import { site, hasPhone, telHref } from "../data/site.js";
import Icon from "./Icon.astro";
import Stars from "./Stars.astro";
import { getFact } from "../data/entity-truth.ts";

const mealTimes = getFact("mealTimes");
const street = getFact("street");

const { media, rating } = site;
const { h1, hoursLine = "" } = Astro.props;
---

<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__tamil tamil" lang="ta">{site.nameTamil}</p>
      <!-- The brand sits inside the H1 so the heading always pairs "Brihadhee" with its
           category (disambiguation from Brihadeeswarar Temple and baby-name pages). -->
      <h1 class="hero__heading">
        <span class="hero__title">{site.name}</span><span class="visually-hidden">: </span>
        <span class="hero__title-sub hero__h1">{h1}</span>
      </h1>
      {hoursLine && <p class="hero__hours">{hoursLine}</p>}
      <p class="hero__tagline">{site.tagline}</p>
      <p class="hero__sub">{site.subTagline}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#menu">
          <Icon name="utensils" size={18} />
          View menu
        </a>
        <a
          class="btn btn--ghost"
          href={site.maps.directions}
          target="_blank"
          rel="noopener"
        >
          <Icon name="navigation" size={18} />
          Get directions
        </a>
        {
          hasPhone && (
            <a class="btn btn--ghost" href={telHref}>
              <Icon name="phone" size={18} />
              Call now
            </a>
          )
        }
      </div>

      <ul class="hero__facts" role="list">
        <li>100% pure veg</li>
        <li>{mealTimes.charAt(0).toUpperCase() + mealTimes.slice(1)}</li>
        <li>{street.split(", Anna Nagar East")[0]}</li>
        <li>Dine-in and catering</li>
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero-showcase" data-hero-showcase>
        <div class="hero-showcase__glow" aria-hidden="true"></div>
        <figure class="hero-showcase__photo">
          <img
            src={media.hero.src}
            srcset={media.hero.srcset}
            sizes="(max-width: 900px) 92vw, 46vw"
            width={media.hero.width}
            height={media.hero.height}
            alt={media.hero.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        {rating && (
          <a
            class="hero-showcase__rating"
            href={site.maps.directions}
            target="_blank"
            rel="noopener"
            aria-label={`Rated ${rating.value} out of 5 from ${rating.count} ${rating.source} reviews. Open map.`}
          >
            <span class="hero-showcase__rating-score">{rating.value}</span>
            <span class="hero-showcase__rating-copy">
              <span class="hero-showcase__stars"><Stars value={rating.value} size={12} /></span>
              <span>{rating.count} {rating.source} reviews</span>
            </span>
          </a>
        )}
        <span class="hero-showcase__tag">
          <span aria-hidden="true">●</span>
          Anna Nagar East <i>•</i> Freshly made
        </span>
      </div>
    </div>
  </div>
</section>
