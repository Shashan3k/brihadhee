---
import { site } from "../data/site.js";
import Icon from "./Icon.astro";

const { media } = site;

const highlights = [
  {
    title: "A menu of dosas",
    text: "A range of dosas from the menu, from kal dosa and ghee roast to rava and ragi dosa, served with chutneys and sides.",
  },
  {
    title: "Traditional tumbler drinks",
    text: "Served in the familiar steel tumbler and davara.",
  },
  {
    title: "Meals on banana leaf",
    text: "Rice and meals are served on a banana leaf, with the whole table eating together.",
  },
];
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__body reveal">
      <p class="eyebrow">Our story</p>
      <h2 class="section__title" id="about-title">
        A vegetarian South Indian kitchen in the heart of Anna Nagar
      </h2>
      <p class="section__lead">{site.longDescription}</p>

      <p class="dropcap">
        Brihadhee brings South Indian favourites together, from crisp dosas and
        banana-leaf meals to traditional tumbler drinks.
      </p>
      <p>{site.entitySentence}</p>
      <p>
        Browse the photo collection for a closer look at the dishes served at
        Brihadhee in Anna Nagar East.
      </p>

      <ul class="feature-list" role="list">
        {
          highlights.map((item) => (
            <li>
              <Icon name="check" />
              <span>
                <strong>{item.title}.</strong> {item.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="about__media reveal" style="--reveal-delay:120ms">
      <figure class="about__img">
        <img
          src={media.about.src}
          width={media.about.width}
          height={media.about.height}
          alt={media.about.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="about__coffee">
        <img
          src={media.coffee.src}
          width={media.coffee.width}
          height={media.coffee.height}
          alt={media.coffee.alt}
          loading="lazy"
          decoding="async"
        />
        <div>
          <strong>Traditional tumbler drink</strong>
          <span>A frothy drink served in a traditional steel tumbler.</span>
        </div>
      </div>
    </div>
  </div>
</section>
