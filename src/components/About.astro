---
/**
 * Home page "Why Guests Choose Brihadhee": an answer-first lead, then the reasons,
 * each built from a verified fact (entity-truth.ts) or the menu (menu-facts.js).
 */
import { site, ROUTES, href } from "../data/site.js";
import Icon from "./Icon.astro";
import { getFact, factOr, openingTimes } from "../data/entity-truth.ts";
import { byo, rupees } from "../lib/menu-facts.js";
import { cateringEnabled, corporate, guests } from "../data/catering.js";

const { media } = site;
const { range } = openingTimes();
const num = (n) => n.toLocaleString("en-IN");
const founders = factOr("founders");

const reasons = [
  { title: "100% pure vegetarian", text: `No meat, egg or fish on the menu, and alcohol is ${getFact("alcohol")}.` },
  {
    title: "A dosa built your way",
    text: `${byo.batterCount} batters from ${rupees(byo.batterMin)}, podis, fillings and a ghee, butter or oil roast, plus ${byo.suggestionCount} chef's combinations.`,
  },
  { title: "Nellai and Karaikudi dishes", text: `Nellai Special Sodhi Meals, Karuppatti Ulundhu Kali and Karaikudi Paneer Poppers, ${getFact("recipeStory").replace(/^Tamil home-style food /, "")}.` },
  { title: `Open every day, ${range}`, text: `Lunch and dinner, dine-in, and families welcome.` },
  { title: "Banana-leaf meals and filter coffee", text: "Meals served on a banana leaf, and drinks such as filter coffee in a steel tumbler and davara." },
  ...(cateringEnabled && corporate && guests
    ? [
        {
          title: "Catering from the same kitchen",
          text: `Offices (more than ${num(corporate.dailyCovers)} meals a day) and events for ${num(guests.min)} to ${num(guests.max)} guests.`,
        },
      ]
    : []),
];
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__body reveal">
      <p class="eyebrow">Why Brihadhee</p>
      <h2 class="section__title" id="about-title">Why Guests Choose {site.name}</h2>
      <p class="section__lead">
        Guests choose {site.name} for 100% pure vegetarian South Indian food, a dosa they build themselves, Nellai dishes
        from grandma's recipes and a kitchen open every day from {range}.
      </p>

      <ul class="feature-list" role="list">
        {
          reasons.map((item) => (
            <li>
              <Icon name="check" />
              <span>
                <strong>{item.title}.</strong> {item.text}
              </span>
            </li>
          ))
        }
      </ul>

      <p>{site.longDescription}</p>
      {founders && (
        <p>
          {site.name} was founded by {founders.names.join(" and ")}. <a href={`${href(ROUTES.about)}#story`}>Read our story</a>, or see <a href={href(ROUTES.whatsNew)}>what's new at {site.name} this month</a>.
        </p>
      )}
    </div>

    <div class="about__media reveal" style="--reveal-delay:120ms">
      <figure class="about__img">
        <img
          src={media.about.src}
          srcset={media.about.srcset}
          sizes="(max-width: 900px) 92vw, 45vw"
          width={media.about.width}
          height={media.about.height}
          alt={media.about.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="about__coffee">
        <img
          src={media.coffee.src}
          srcset={media.coffee.srcset}
          sizes="160px"
          width={media.coffee.width}
          height={media.coffee.height}
          alt={media.coffee.alt}
          loading="lazy"
          decoding="async"
        />
        <div>
          <strong>Traditional tumbler drink</strong>
          <span>A frothy drink served in a traditional steel tumbler.</span>
        </div>
      </div>
    </div>
  </div>
</section>
