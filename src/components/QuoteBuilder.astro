---
/**
 * Catering quote builder (/catering-quote-chennai/), with the fields the client
 * asked for on the Wf call: event type, lunch or dinner, occasion, guest count,
 * the spend in mind, must-have dishes and whether serving staff is needed.
 *
 * Two modes, set by config/seo-gates.ts (ENABLE_LIVE_WHATSAPP_QUOTE_FORM, Q19):
 *  - gate off (default): posts to /api/lead like LeadForm (emailed to the team;
 *    works without JavaScript), with call and the restaurant's WhatsApp beside it.
 *  - gate on: src/scripts/main.js formats the answers into a WhatsApp message
 *    (quoteWhatsAppText in src/lib/lead.js) and opens wa.me for the office number,
 *    and still posts a copy to /api/lead.
 * The 50-guest floor is enforced three times: min="50" on the input (no JS), an
 * inline notice while typing (main.js), and validateLead() on the server.
 * No rupee figure appears: the spend options are tiers.
 */
import Icon from "./Icon.astro";
import { ROUTES, href, pageContact } from "../data/site.js";
import {
  HONEYPOT,
  QUOTE_EVENT_TYPES,
  QUOTE_MEALS,
  QUOTE_SPEND,
  QUOTE_SERVICE,
  QUOTE_MIN_GUESTS,
  QUOTE_MAX_GUESTS,
} from "../lib/lead.js";

const { id = "enquiry", page = "/", whatsappNumber = null, min = QUOTE_MIN_GUESTS, fallbackWhatsapp = null } = Astro.props;
if (min !== QUOTE_MIN_GUESTS) {
  throw new Error(`[QuoteBuilder] min guests ${min} != QUOTE_MIN_GUESTS ${QUOTE_MIN_GUESTS} in src/lib/lead.js`);
}
const { phone, whatsapp, hasPhone, hasWhatsApp, telHref, whatsappHref } = pageContact(Astro);
const waDigits = whatsappNumber ? whatsappNumber.replace(/\D/g, "") : "";
const f = (n) => `${id}-${n}`;
const today = new Date().toISOString().slice(0, 10);
const fallbackText = encodeURIComponent("Hi Brihadhee, I'd like a catering quote. Event: , lunch or dinner: , guests: , date: , venue: .");
---

<section class="section section--tint" id={id} aria-labelledby={`${id}-title`}>
  <div class="container contact__grid">
    <div>
      <h2 class="section__title" id={`${id}-title`}>Build your catering quote</h2>
      <p class="section__lead">
        {waDigits
          ? "Fill in the details, and the form opens WhatsApp with a message ready to send to the Brihadhee catering team."
          : "Fill in the details, and the Brihadhee team calls you back with a menu and a per-plate price."}
      </p>
      <ul class="dish-list" role="list">
        <li><strong>From {min} guests</strong></li>
        <li><strong>Lunch or dinner</strong></li>
        <li><strong>No fixed rates:</strong> each quote is built for your event</li>
      </ul>
      {!waDigits && (
        <div class="catering__cta">
          {hasPhone && (
            <a class="btn btn--ghost" href={telHref} data-event="click_call">
              <Icon name="phone" size={17} /> Call {phone}
            </a>
          )}
          {fallbackWhatsapp && hasWhatsApp && (
            <a class="btn btn--ghost" href={`${whatsappHref}?text=${fallbackText}`} target="_blank" rel="noopener" data-event="click_whatsapp">
              <Icon name="whatsapp" size={17} /> WhatsApp {whatsapp}
            </a>
          )}
        </div>
      )}
      <p class="lead-form__note" data-lead-result hidden></p>
    </div>

    <form
      class="contact__form lead-form"
      action="/api/lead"
      method="post"
      data-lead-form
      data-form-type="quote"
      data-min-guests={min}
      data-whatsapp-quote={waDigits || undefined}
    >
      <input type="hidden" name="formType" value="quote" />
      <input type="hidden" name="page" value={page} />
      <input type="hidden" name="startedAt" value="" data-started-at />
      <div class="lead-form__trap" aria-hidden="true">
        <label for={f(HONEYPOT)}>Leave this empty</label>
        <input type="text" id={f(HONEYPOT)} name={HONEYPOT} tabindex="-1" autocomplete="off" />
      </div>

      <p class="field__hint">Catering quote · fields marked * are required</p>

      <div class="field">
        <label for={f("eventType")}>1. Event type *</label>
        <select id={f("eventType")} name="eventType" required>
          <option value="">Choose</option>
          {QUOTE_EVENT_TYPES.map((x) => <option value={x}>{x}</option>)}
        </select>
      </div>
      <div class="field">
        <label for={f("meal")}>2. Lunch or dinner *</label>
        <select id={f("meal")} name="meal" required>
          <option value="">Choose</option>
          {QUOTE_MEALS.map((x) => <option value={x}>{x}</option>)}
        </select>
      </div>
      <div class="field">
        <label for={f("occasion")}>3. Occasion</label>
        <input type="text" id={f("occasion")} name="occasion" maxlength="120" placeholder="e.g. 60th birthday, housewarming, team celebration" />
      </div>
      <div class="field">
        <label for={f("guests")}>4. Number of guests * (from {min})</label>
        <input
          type="number"
          id={f("guests")}
          name="guests"
          min={min}
          max={QUOTE_MAX_GUESTS}
          step="1"
          inputmode="numeric"
          required
          aria-describedby={f("guests-note")}
        />
        <p class="field__hint" id={f("guests-note")} data-guests-note hidden>
          Brihadhee caters functions from {min} guests. For a smaller group, <a href={href(ROUTES.book)}>book a table at the restaurant</a> instead.
        </p>
      </div>
      <div class="field">
        <label for={f("spend")}>5. What spend do you have in mind?</label>
        <select id={f("spend")} name="spend">
          <option value="">Choose</option>
          {QUOTE_SPEND.map((x) => <option value={x}>{x}</option>)}
        </select>
      </div>
      <div class="field">
        <label for={f("mustHave")}>6. Must-have dishes</label>
        <textarea id={f("mustHave")} name="mustHave" maxlength="600" placeholder="e.g. Nellai sodhi, Paanai Parotta, a live build-your-own dosa counter"></textarea>
      </div>
      <div class="field">
        <label for={f("service")}>7. Serving staff needed? *</label>
        <select id={f("service")} name="service" required>
          <option value="">Choose</option>
          {QUOTE_SERVICE.map((x) => <option value={x}>{x}</option>)}
        </select>
      </div>
      <div class="field">
        <label for={f("date")}>Event date</label>
        <input type="date" id={f("date")} name="date" min={today} />
      </div>
      <div class="field">
        <label for={f("location")}>Venue area in Chennai *</label>
        <input type="text" id={f("location")} name="location" maxlength="120" placeholder="e.g. Anna Nagar, Kilpauk, OMR" required />
      </div>
      <div class="field">
        <label for={f("name")}>Your name *</label>
        <input type="text" id={f("name")} name="name" autocomplete="name" maxlength="80" required />
      </div>
      <div class="field">
        <label for={f("phone")}>Phone *</label>
        <input type="tel" id={f("phone")} name="phone" autocomplete="tel" inputmode="tel" maxlength="20" pattern="[+0-9 \-]{10,20}" required />
      </div>
      <div class="field">
        <label for={f("email")}>Email</label>
        <input type="email" id={f("email")} name="email" autocomplete="email" maxlength="120" />
      </div>

      <div class="form__foot">
        <button class="btn btn--primary" type="submit">
          {waDigits ? <><Icon name="whatsapp" size={17} /> Send on WhatsApp</> : "Request my quote"}
        </button>
        <p class="form__status" role="status" aria-live="polite" data-lead-status></p>
      </div>
      <p class="field__hint">
        Your details go to the Brihadhee team only, to reply to you. See the <a href={href("/privacy/")}>privacy policy</a>.
      </p>
    </form>
  </div>
</section>
