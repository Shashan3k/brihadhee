---
/** The corporate page features clients whose verified logo files are available. */
import { existsSync } from "node:fs";
import { join } from "node:path";

const { id, title, lead = "", names = [], tint = false } = Astro.props;
const SLUGS = {
  "Bi3 Technologies": "bi3",
  "Nestlé": "nestle",
  "Selvarangam Hospitals": "selvarangam",
  "Go Khana": "gokhana",
  "HungerBox": "hungerbox",
  "Pro Chant": "prochant",
  "Stark Event Management": "stark",
};
const slugify = (name) => name.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const dir = join(process.cwd(), "public", "images", "clients");
const logoFor = (name) => {
  const slug = SLUGS[name] ?? slugify(name);
  for (const ext of ["svg", "png", "webp"]) {
    if (existsSync(join(dir, `${slug}.${ext}`))) return `${base}images/clients/${slug}.${ext}`;
  }
  return null;
};
const clients = names.map((name) => ({ name, logo: logoFor(name) })).filter((client) => client.logo);
---

{clients.length > 0 && (
  <section class={`clients${tint ? " clients--tint" : ""}`} id={id} aria-labelledby={`${id}-title`}>
    <div class="container">
      <div class="clients__intro">
        <div>
          <span class="eyebrow">Our catering clients</span>
          <h2 class="section__title" id={`${id}-title`}>{title}</h2>
        </div>
        {lead && <p class="clients__lead">{lead}</p>}
      </div>
      <ul class="clients__grid" role="list">
        {clients.map((client) => (
          <li class="clients__card">
            <div class={`clients__logo${client.name === "Bi3 Technologies" ? " clients__logo--dark" : ""}`}>
              <img src={client.logo} alt={`${client.name} logo`} loading="lazy" decoding="async" />
            </div>
            <span class="clients__name">{client.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .clients {
    padding-block: clamp(2rem, 4.5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .clients--tint { background: var(--cream-deep); }
  :global(.clients + .glance) { padding-top: 0; }
  .clients__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .clients__intro > div { max-width: 35rem; }
  .clients__lead {
    max-width: 25rem;
    color: var(--ink-3);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .clients__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.15rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .clients__card {
    min-width: 0;
    padding: 0.7rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .clients__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .clients__logo {
    display: grid;
    place-items: center;
    height: clamp(5rem, 8vw, 6.75rem);
    padding: 1rem;
    border-radius: calc(var(--radius) - 7px);
    background: #f9f4ec;
  }
  .clients__logo--dark { background: #202a39; }
  .clients__logo img {
    display: block;
    max-width: 100%;
    max-height: 4.25rem;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .clients__name {
    display: block;
    min-height: 2.7rem;
    padding: 0.75rem 0.3rem 0.2rem;
    color: var(--ink-2);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
  }
  @media (max-width: 800px) {
    .clients__intro { display: block; }
    .clients__lead { margin-top: 0.75rem; max-width: 38rem; }
    .clients__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 420px) {
    .clients__card { padding: 0.5rem; }
    .clients__logo { height: 5.25rem; padding: 0.65rem; }
    .clients__name { font-size: 0.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .clients__card { transition: none; }
  }
</style>
