---
/**
 * "Companies we have catered for": a scrolling client marquee for the corporate
 * catering page. Names come from the verified corporateClients fact
 * (src/data/entity-truth.ts).
 *
 * Logos: drop a file named after the company's slug into public/images/clients/
 * (svg preferred, then png or webp), e.g. public/images/clients/prodapt.svg.
 * A company with no logo file yet shows its name as a text tile, so a new
 * client can be added to the fact before its logo arrives.
 *
 * Motion: the list is rendered twice and the track slides by exactly one copy,
 * so the loop is seamless. The copy is aria-hidden, so screen readers hear each
 * name once. Hover or keyboard focus pauses it; with prefers-reduced-motion the
 * marquee becomes a static wrapped grid.
 */
import { existsSync } from "node:fs";
import { join } from "node:path";

const { id, title, lead = "", names = [], tint = false } = Astro.props;

/** File slug for each client name. Unlisted names fall back to a slugified name. */
const SLUGS = {
  "Bi3 Technologies": "bi3",
  "Nestlé": "nestle",
  "Selvarangam Hospitals": "selvarangam",
  "Go Khana": "gokhana",
  "HungerBox": "hungerbox",
  "Pro Chant": "prochant",
  "Stark Event Management": "stark",
};
const slugify = (n) => n.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const dir = join(process.cwd(), "public", "images", "clients");
const logoFor = (name) => {
  const slug = SLUGS[name] ?? slugify(name);
  for (const ext of ["svg", "png", "webp"]) {
    if (existsSync(join(dir, `${slug}.${ext}`))) return `${base}images/clients/${slug}.${ext}`;
  }
  return null;
};
const clients = names.map((name) => ({ name, logo: logoFor(name) }));
/* About 3.2 s per tile keeps the pace readable whatever the list length. */
const duration = `${Math.max(24, clients.length * 3.2).toFixed(1)}s`;
---

<section class={`section clients${tint ? " section--tint" : ""}`} id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 class="section__title" id={`${id}-title`}>{title}</h2>
    {lead && <p class="section__lead">{lead}</p>}
  </div>
  <div class="clients__marquee" style={`--marquee-duration: ${duration}`}>
    <div class="clients__track">
      {[0, 1].map((copy) => (
        <ul class="clients__list" role="list" aria-label={copy === 0 ? title : undefined} aria-hidden={copy === 1 ? "true" : undefined}>
          {clients.map((c) => (
            <li class="clients__item">
              {c.logo ? (
                <img src={c.logo} alt={copy === 0 ? c.name : ""} title={c.name} loading="lazy" decoding="async" />
              ) : (
                <span class="clients__name">{c.name}</span>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .clients__marquee {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    overflow: hidden;
    padding-block: 0.4rem 0.9rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  .clients__track {
    display: flex;
    width: max-content;
    animation: clients-scroll var(--marquee-duration, 40s) linear infinite;
  }
  .clients__marquee:hover .clients__track,
  .clients__marquee:focus-within .clients__track {
    animation-play-state: paused;
  }
  .clients__list {
    display: flex;
    gap: clamp(0.7rem, 1.6vw, 1rem);
    padding: 0 clamp(0.35rem, 0.8vw, 0.5rem);
    list-style: none;
    margin: 0;
  }
  .clients__item {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: clamp(9.5rem, 22vw, 12rem);
    height: clamp(5.25rem, 10vw, 6.25rem);
    padding: 0.9rem 1.1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }
  .clients__item img {
    display: block;
    max-width: 100%;
    max-height: 3.1rem;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .clients__name {
    font-family: var(--ff-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink-2);
  }
  @keyframes clients-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clients__marquee {
      -webkit-mask-image: none;
      mask-image: none;
      max-width: var(--max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }
    .clients__track {
      animation: none;
      width: auto;
    }
    .clients__list {
      flex-wrap: wrap;
      padding: 0;
    }
    .clients__list[aria-hidden="true"] {
      display: none;
    }
  }
</style>
