---
import { site } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="services__intro reveal">
      <div>
        <p class="eyebrow">Four ways to gather</p>
        <h2 class="section__title" id="services-title">Made for everyday meals and memorable occasions</h2>
      </div>
      <p class="section__lead">
        From a table at Brihadhee to daily workplace meals and celebrations, find the right way to bring people together over South Indian food.
      </p>
    </div>

    <div class="services__grid">
      <article class="service service--restaurant reveal">
        <span class="service__index">01 / DINE IN</span>
        <Icon name="utensils" size={24} class="service__icon" />
        <h3>Restaurant</h3>
        <p>Drop in for crisp dosas, Tamil Nadu meals and familiar South Indian favourites.</p>
        <a class="service__link" href="#menu">Explore the menu <Icon name="arrowRight" size={17} /></a>
      </article>

      <article class="service service--cloud reveal" style="--reveal-delay:70ms">
        <span class="service__index">02 / CLOUD KITCHEN</span>
        <Icon name="sparkle" size={24} class="service__icon" />
        <h3>Value-Meal-Box</h3>
        <p>A convenient, value-focused meal-box concept from the Brihadhee kitchen.</p>
        <span class="service__teaser"><span class="service__dot"></span> More offerings coming soon</span>
        <span class="service__coming">Build Your Own Dosa · Coming soon</span>
      </article>

      <article class="service service--corporate reveal" style="--reveal-delay:140ms">
        <span class="service__index">03 / FOR WORKPLACES</span>
        <Icon name="users" size={24} class="service__icon" />
        <h3>Corporate catering</h3>
        <p>Reliable daily food service for teams, prepared with restaurant-quality care and consistent standards.</p>
        <ul class="service__proof" role="list">
          <li>Restaurant-quality food at catering prices</li>
          <li>Same professional kitchen and hygiene standards as our restaurant</li>
          <li>Rigorous quality control</li>
          <li>Consistent taste and freshness, every day</li>
        </ul>
        <a class="service__link" href="#contact" data-inquiry="corporate">Discuss workplace catering <Icon name="arrowRight" size={17} /></a>
      </article>

      <article class="service service--events reveal" style="--reveal-delay:210ms">
        <span class="service__index">04 / FOR GATHERINGS</span>
        <Icon name="leaf" size={24} class="service__icon" />
        <h3>Event catering</h3>
        <p>South Indian food for weddings, birthdays, community gatherings and custom bulk requirements.</p>
        <a class="btn btn--onink service__cta" href="#contact" data-inquiry="event">Get an event quote <Icon name="arrowRight" size={17} /></a>
      </article>
    </div>

    <div class="services__clients reveal">
      <div class="services__clients-head">
        <p class="eyebrow">Workplace catering</p>
        <h3>Trusted by teams at</h3>
      </div>
      <ul class="client-list" role="list" aria-label="Corporate catering clients">
        {site.catering.clients.map((client) => <li>{client}</li>)}
      </ul>
    </div>
  </div>
</section>
