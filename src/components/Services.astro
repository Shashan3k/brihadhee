---
import { site } from "../data/site.js";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="services__intro reveal">
      <div>
        <p class="eyebrow">Two ways to enjoy Brihadhee</p>
        <h2 class="section__title" id="services-title">Made for everyday South Indian meals</h2>
      </div>
      <p class="section__lead">
        From a table at Brihadhee to a convenient meal box, find the right way to enjoy South Indian food.
      </p>
    </div>

    <div class="services__grid">
      <article class="service service--restaurant reveal">
        <span class="service__index">01 / DINE IN</span>
        <Icon name="utensils" size={24} class="service__icon" />
        <h3>Restaurant</h3>
        <p>Drop in for crisp dosas, Tamil Nadu meals and familiar South Indian favourites.</p>
        <a class="service__link" href="#menu">Explore the menu <Icon name="arrowRight" size={17} /></a>
      </article>

      <article class="service service--cloud reveal" style="--reveal-delay:70ms">
        <span class="service__index">02 / CLOUD KITCHEN</span>
        <Icon name="sparkle" size={24} class="service__icon" />
        <h3>Value-Meal-Box</h3>
        <p>A convenient, value-focused meal-box concept from the Brihadhee kitchen.</p>
        <div class="meal-box__photos" aria-label="Value meal box examples">
          <figure>
            <img src={`${base}images/meal-box-rice.jpg`} width="1200" height="1200" alt="Meal box with yellow rice and a spiced rice dish" loading="lazy" decoding="async" />
            <figcaption>Rice meal box</figcaption>
          </figure>
          <figure>
            <img src={`${base}images/meal-box-roti.jpg`} width="1200" height="1200" alt="Meal box with flatbreads and curry" loading="lazy" decoding="async" />
            <figcaption>Flatbread meal box</figcaption>
          </figure>
        </div>
        <span class="service__teaser"><span class="service__dot"></span> More offerings coming soon</span>
        <span class="service__coming">Build Your Own Dosa · Coming soon</span>
      </article>
    </div>

  </div>
</section>
