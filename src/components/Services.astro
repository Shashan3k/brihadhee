---
import { site, responsive } from "../data/site.js";
import Icon from "./Icon.astro";
import { getFact, factOr } from "../data/entity-truth.ts";
import verification from "../../config/client-verification.json";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const subBrand = getFact("subBrand");
const cat = factOr("catering");
const cateringOn = verification.offer_catering === true && Boolean(cat);
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="services__intro reveal">
      <div>
        <p class="eyebrow">Restaurant and catering</p>
        <h2 class="section__title" id="services-title">Dine with us, or bring Brihadhee to your function</h2>
      </div>
      <p class="section__lead">
        Brihadhee serves regional Tamil vegetarian food on {getFact("street")}, and caters pure vegetarian functions across {cat?.area ?? "Chennai"}.
      </p>
    </div>

    <div class="services__grid">
      <article class="service service--restaurant reveal">
        <span class="service__index">01 / DINE IN</span>
        <Icon name="utensils" size={24} class="service__icon" />
        <h3>Restaurant</h3>
        <p>Build-your-own dosas, Paanai Parotta and Nellai Special Sodhi Meals, served for {getFact("mealTimes")}.</p>
        <a class="service__link" href={`${base}best-dosa-parotta-anna-nagar/`}>Dosa and parotta <Icon name="arrowRight" size={17} /></a>
        <a class="service__link" href={`${base}nellai-meals-south-indian-veg-anna-nagar/`}>Nellai meals and lunch <Icon name="arrowRight" size={17} /></a>
      </article>

      <article class="service service--cloud reveal" style="--reveal-delay:70ms">
        <span class="service__index">02 / MEAL BOXES</span>
        <Icon name="sparkle" size={24} class="service__icon" />
        <h3>{subBrand.name}</h3>
        <p>{subBrand.description.charAt(0).toUpperCase() + subBrand.description.slice(1)} from the Brihadhee kitchen.</p>
        <div class="meal-box__photos" aria-label="Beyond Curry meal box examples">
          <figure>
            <img {...responsive("meal-box-rice", 1200)} sizes="(max-width: 700px) 45vw, 200px" width="1200" height="1200" alt="Meal box with yellow rice and a spiced rice dish" loading="lazy" decoding="async" />
            <figcaption>Rice meal box</figcaption>
          </figure>
          <figure>
            <img {...responsive("meal-box-roti", 1200)} sizes="(max-width: 700px) 45vw, 200px" width="1200" height="1200" alt="Meal box with flatbreads and curry" loading="lazy" decoding="async" />
            <figcaption>Flatbread meal box</figcaption>
          </figure>
        </div>
      </article>

      {cateringOn && (
        <article class="service service--events reveal" style="--reveal-delay:140ms">
          <span class="service__index">03 / FUNCTIONS</span>
          <Icon name="leaf" size={24} class="service__icon" />
          <h3>Corporate and event catering</h3>
          <p>Daily corporate catering for more than {getFact("corporateCatering").dailyCovers.toLocaleString("en-IN")} people, and end-to-end catering for weddings, birthdays, get-togethers and family functions, for {cat.guests.min} to {cat.guests.max.toLocaleString("en-IN")} guests across {cat.area}.</p>
          <a class="btn btn--onink service__cta" href={`${base}catering-services-chennai/`}>Catering details <Icon name="arrowRight" size={17} /></a>
        </article>
      )}

      {cateringOn && (
        <article class="service service--corporate reveal" style="--reveal-delay:210ms">
          <span class="service__index">04 / EVENT PLANNERS</span>
          <Icon name="users" size={24} class="service__icon" />
          <h3>Catering partner for event managers</h3>
          <p>White-label or co-branded live counters for {cat.liveCounters.join(", ")}, with per-plate pricing.</p>
          <a class="service__link" href={`${base}event-planner-catering-partner/`}>Partner with Brihadhee <Icon name="arrowRight" size={17} /></a>
        </article>
      )}
    </div>
  </div>
</section>
