---
import { faqItems, faqLanguageGroups } from "../data/faq.js";
import { CONTENT_UPDATED, monthYear } from "../data/entity-truth.ts";

// Visible Q&A. Each page passes the SAME array it gives to faqPageSchema(), so
// the text in the JSON-LD and on the page cannot drift apart (checked by
// scripts/aeo-lint.mjs). Questions are <h3> headings; the first paragraph is
// the direct answer.
const {
  items = faqItems,
  title = "Frequently asked questions",
  lead = "Straight answers about Brihadhee's food, location, hours and offers.",
  eyebrow = "Quick answers",
  moreHref = "", // optional link to the /faq/ hub
  moreLabel = "All Brihadhee questions and answers",
} = Astro.props;
const english = items.filter((i) => !i.lang || i.lang === "en");
const other = items.filter((i) => i.lang && i.lang !== "en");
const slug = (q) => q.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60);
---

{
  items.length > 0 && (
    <section class="section faq" id="faq" aria-labelledby="faq-title">
      <div class="container faq__inner">
        <div class="section__head section__head--center">
          <p class="eyebrow">{eyebrow}</p>
          <h2 class="section__title" id="faq-title">{title}</h2>
          {lead && <p class="section__lead">{lead}</p>}
          <p class="faq__updated">Last updated: <time datetime={CONTENT_UPDATED}>{monthYear(CONTENT_UPDATED)}</time></p>
        </div>

        <div class="faq__list">
          {english.map((item) => (
            <details class="faq__item" id={`faq-${item.id ?? slug(item.question)}`}>
              <summary>
                <h3 class="faq__q">{item.question}</h3>
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <p class="faq__answer">{item.answer}</p>
            </details>
          ))}
        </div>

        {moreHref && <p class="faq__updated"><a href={moreHref}>{moreLabel}</a></p>}

        {other.length > 0 && (
          <>
            <h3 class="faq__group" lang="ta">{faqLanguageGroups.ta}</h3>
            <div class="faq__list">
              {other.map((item) => (
                <details class="faq__item" id={`faq-${item.id ?? slug(item.question)}`}>
                  <summary>
                    <h3 class="faq__q" lang={item.lang}>{item.question}</h3>
                    <span class="faq__icon" aria-hidden="true" />
                  </summary>
                  <p class="faq__answer" lang={item.lang}>{item.answer}</p>
                </details>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )
}
