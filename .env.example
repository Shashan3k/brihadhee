# Copy to .env for local builds; set the same names in Vercel → Settings → Environment Variables.
# All optional. Never commit a real .env (it is in .gitignore).

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty for no analytics.
PUBLIC_GA4_ID=

# Meta Pixel ID (digits only, from Events Manager → Data sources → your pixel). Leave empty for no Meta tracking.
PUBLIC_META_PIXEL_ID=

# IndexNow key: 8–128 letters, numbers or dashes (generate one at https://www.bing.com/indexnow/getstarted).
# Builds /<key>.txt; `npm run indexnow` pings Bing and Yandex after a deploy. Empty = skip.
INDEXNOW_KEY=
